{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f package.json ] || npm run -s --if-present check 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
