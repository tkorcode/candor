{
  "name": "candor",
  "version": "0.1.0",
  "private": true,
  "description": "Oversight layer for long-running Claude Code jobs: checks each stage against the goal, lets a person correct course, and ends with a signed trust receipt.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "candor": "bin/candor.js",
    "candord": "bin/candord.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "deps:check": "node scripts/deps.mjs --check",
    "deps:render": "node scripts/deps.mjs --write",
    "eval": "npm run build && node dist/bench/run-eval.js",
    "check": "npm run typecheck && npm run lint && npm run deps:check && npm run test",
    "results:redact": "npm run build && node scripts/redact-results.mjs",
    "site:data": "node scripts/site-data.mjs",
    "site:serve": "npm run build && node scripts/site-data.mjs && node scripts/site-serve.mjs",
    "hosted:sample": "node scripts/hosted-sample.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "acorn": "^8.19.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
