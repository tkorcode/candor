{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": [
        "/Users/owner/.candor-restart-smoke"
      ],
      "denyRead": [
        "/Users/owner/.candor-restart-smoke/operator.key",
        "/Users/owner/.candor-restart-smoke/receipt.key",
        "/Users/owner/.candor-restart-smoke/runs/r_m4live/oracle"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Edit(//Users/owner/.candor-restart-smoke/**)",
      "Write(//Users/owner/.candor-restart-smoke/**)",
      "MultiEdit(//Users/owner/.candor-restart-smoke/**)",
      "NotebookEdit(//Users/owner/.candor-restart-smoke/**)",
      "Read(//Users/owner/.candor-restart-smoke/operator.key)",
      "Read(//Users/owner/.candor-restart-smoke/receipt.key)",
      "Read(//Users/owner/.candor-restart-smoke/runs/r_m4live/oracle/**)",
      "Edit(//Users/owner/.candor-restart-smoke/operator.key)",
      "Edit(//Users/owner/.candor-restart-smoke/receipt.key)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.local/node/bin/node",
            "args": [
              "/Users/owner/GitHub/candor-restart/bin/candor.js",
              "hook",
              "SessionStart"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.local/node/bin/node",
            "args": [
              "/Users/owner/GitHub/candor-restart/bin/candor.js",
              "hook",
              "PreToolUse"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.local/node/bin/node",
            "args": [
              "/Users/owner/GitHub/candor-restart/bin/candor.js",
              "hook",
              "PostToolUse"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.local/node/bin/node",
            "args": [
              "/Users/owner/GitHub/candor-restart/bin/candor.js",
              "hook",
              "PostToolUseFailure"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.local/node/bin/node",
            "args": [
              "/Users/owner/GitHub/candor-restart/bin/candor.js",
              "hook",
              "SubagentStart"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.local/node/bin/node",
            "args": [
              "/Users/owner/GitHub/candor-restart/bin/candor.js",
              "hook",
              "SubagentStop"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.local/node/bin/node",
            "args": [
              "/Users/owner/GitHub/candor-restart/bin/candor.js",
              "hook",
              "PreCompact"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.local/node/bin/node",
            "args": [
              "/Users/owner/GitHub/candor-restart/bin/candor.js",
              "hook",
              "ConfigChange"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.local/node/bin/node",
            "args": [
              "/Users/owner/GitHub/candor-restart/bin/candor.js",
              "hook",
              "Stop"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.local/node/bin/node",
            "args": [
              "/Users/owner/GitHub/candor-restart/bin/candor.js",
              "hook",
              "SessionEnd"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}