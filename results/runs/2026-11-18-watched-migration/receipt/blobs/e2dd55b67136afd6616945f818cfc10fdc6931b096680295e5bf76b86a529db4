    const ids = [g.keep, ...g.drop];\n+      for (const id of ids) {\n+        const row = byId.get(id);\n+        if (!row) throw new Error(`plan references unknown id ${id}`);\n+        if (seen.has(id)) throw new Error(`id ${id} appears more than once in plan`);\n+        seen.add(id);\n+        if (normalizeEmail(row.email) !== g.email) {\n+          throw new Error(`id ${id} email does not match group ${g.email}`);\n+        }\n+      }\n+    }\n+    if (seen.size !== v1Rows.length) {\n+      throw new Error(`plan covers ${seen.size} rows but customers_v1 has ${v1Rows.length}`);\n+    }\n+\n+    db.exec('BEGIN');\n+    db.exec('DROP TABLE IF EXISTS customers_v2');\n+    db.exec(`CREATE TABLE customers_v2 (\n+      customer_id INTEGER PRIMARY KEY,\n+      full_name TEXT,\n+      email TEXT,\n+      phone TEXT,\n+      city TEXT,\n+      last_contact TEXT\n+    )`);\n+\n+    const insert = db.prepare(\n+      'INSERT INTO customers_v2 (customer_id, full_name, email, phone, city, last_contact) VALUES (?, ?, ?, ?, ?, ?)'\n+    );\n+\n+    let inserted = 0;\n+    for (const g of plan.groups) {\n+      const row = byId.get(g.keep);\n+      insert.run(\n+        row.id,\n+        row.full_name,\n+        normalizeEmail(row.email),\n+        row.phone,\n+        row.city,\n+        row.updated_at\n+      );\n+      inserted++;\n+    }\n+    db.exec('COMMIT');\n+\n+    const count = db.prepare('SELECT COUNT(*) AS n FROM customers_v2').get().n;\n+    const dropped = seen.size - inserted;\n+    console.log(\n+      JSON.stringify({ source_rows: v1Rows.length, groups: plan.groups.length, inserted, dropped, customers_v2_rows: count })\n+    );\n+  } catch (err) {\n+    try {\n+      db.exec('ROLLBACK');\n+    } catch (_) {\n+      // no open transaction\n+    }\n+    throw err;\n+  } finally {\n+    db.close();\n+  }\n+}\n+\n+function main() {\n+  const cmd = process.argv[2];\n+  if (cmd !== 'run') {\n+    console.error('Usage: node migration/apply.js run');\n+    process.e